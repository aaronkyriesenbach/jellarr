{
  "name": "jellarr",
  "version": "0.2.0",
  "description": "Declarative configuration management for Jellyfin servers",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronkyriesenbach/jellarr.git"
  },
  "homepage": "https://github.com/aaronkyriesenbach/jellarr",
  "bugs": {
    "url": "https://github.com/aaronkyriesenbach/jellarr/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.6",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "fast-equals": "^5.3.2",
    "json-diff-ts": "^4.8.2",
    "openapi-fetch": "^0.15.0",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "bun esbuild.ts",
    "dev": "bun src/cli/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typegen": "bunx openapi-typescript https://api.jellyfin.org/openapi/jellyfin-openapi-stable.json -o ./generated/schema.d.ts"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
